# ============================================
# সম্পূর্ণ সংশোধিত .htaccess ফাইল
# Render.com-এর সাথে সামঞ্জস্যপূর্ণ
# ============================================

# Apache মডিউল চেক
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # HTTP থেকে HTTPS-এ রিডাইরেক্ট (Render-এর জন্য প্রয়োজনীয়)
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
    
    # ইন্ডেক্স পৃষ্ঠা সেট করা
    DirectoryIndex index.php index.html
    
    # URL রিডাইরেক্ট (যদি প্রয়োজন হয়)
    # RewriteRule ^old-page$ /new-page [R=301,L]
</IfModule>

# ============================================
# নিরাপত্তা হেডার (সব রিকোয়েস্টের জন্য)
# ============================================
<IfModule mod_headers.c>
    # XSS সুরক্ষা
    Header set X-XSS-Protection "1; mode=block" env=!dont-set-header
    
    # কন্টেন্ট টাইপ স্নিফিং প্রতিরোধ
    Header set X-Content-Type-Options "nosniff" env=!dont-set-header
    
    # রেফারার পলিসি
    Header set Referrer-Policy "strict-origin-when-cross-origin" env=!dont-set-header
    
    # HSTS (শুধুমাত্র HTTPS-এর জন্য)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=!dont-set-header
    
    # ফ্রেমিং প্রতিরোধ (ক্লিকজ্যাকিং)
    Header always append X-Frame-Options SAMEORIGIN
</IfModule>

# ============================================
# ফাইল অ্যাক্সেস সুরক্ষা (ServerTokens-এর পরিবর্তে FilesMatch ব্যবহার)
# ============================================
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|json|lock|config)$">
    Require all denied
</FilesMatch>

# ============================================
# সংবেদনশীল ফাইল সুরক্ষা
# ============================================
<FilesMatch "(^\.|composer\.|package\.|web\.|artisan$)">
    Require all denied
</FilesMatch>

# ============================================
# ডিরেক্টরি লিস্টিং বন্ধ করা
# ============================================
Options -Indexes

# ============================================
# ডেটা ডিরেক্টরি সুরক্ষা (ডিরেক্টরি ডিরেক্টিভের পরিবর্তে)
# ============================================
<IfModule mod_authz_core.c>
    # ডেটা ফোল্ডারের ফাইল অ্যাক্সেস নিষিদ্ধ
    <FilesMatch "^(data/).*\.(db|sqlite|sqlite3|log)$">
        Require all denied
    </FilesMatch>
</IfModule>

# ============================================
# ত্রুটি পৃষ্ঠা কাস্টমাইজেশন
# ============================================
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php

# ============================================
# পারফরম্যান্স: ক্যাশিং (সাধারণ ফাইলের জন্য)
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ============================================
# কম্প্রেশন (Gzip)
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
